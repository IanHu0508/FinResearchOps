{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finauditgate:schema:security-market:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "identity",
    "market",
    "limits",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "finauditgate.security-market/v1"
    },
    "task": {
      "type": "object"
    },
    "identity": {
      "type": "object"
    },
    "market": {
      "type": "object"
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "const": "HUMAN_REVIEW"
    }
  }
}
