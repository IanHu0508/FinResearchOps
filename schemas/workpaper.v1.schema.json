{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finresearchops:schema:workpaper:v1",
  "title": "FinResearchOps Workpaper v1",
  "description": "A content-addressed mapping from one Case and FinAuditGate RunRef to replay-verified core artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_ref",
    "run_ref",
    "machine_decision",
    "answer",
    "answer_unit",
    "document_sha256",
    "evidence_ledger_ref",
    "formula_ref",
    "candidate_artifact_ref",
    "attempts_artifact_ref",
    "trace_summary_ref",
    "trace_summary_status",
    "gate_reason_codes",
    "workpaper_ref"
  ],
  "properties": {
    "schema_version": {"const": "finresearchops.workpaper/v1"},
    "case_ref": {"type": "string", "pattern": "^case-[0-9a-f]{64}$"},
    "run_ref": {"$ref": "urn:finauditgate:schema:run-ref:v1"},
    "machine_decision": {"enum": ["ACCEPT", "RETRY", "ABSTAIN", "HUMAN_REVIEW"]},
    "answer": {"type": ["string", "null"]},
    "answer_unit": {"type": ["string", "null"]},
    "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_ledger_ref": {"type": "string", "pattern": "^runs/[0-9a-f]{64}/ledger\\.json$"},
    "formula_ref": {"type": "string", "pattern": "^runs/[0-9a-f]{64}/formula\\.json$"},
    "candidate_artifact_ref": {"type": "string", "pattern": "^runs/[0-9a-f]{64}/candidate\\.json$"},
    "attempts_artifact_ref": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^runs/[0-9a-f]{64}/attempts\\.json$"}
      ]
    },
    "trace_summary_ref": {
      "type": "string",
      "pattern": "^runs/[0-9a-f]{64}/(?:attempts|candidate)\\.json$"
    },
    "trace_summary_status": {
      "enum": ["ATTEMPTS_RECORDED", "SCRIPTED_CANDIDATE_RECORDED"]
    },
    "gate_reason_codes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "workpaper_ref": {"type": "string", "pattern": "^workpaper-[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"machine_decision": {"const": "ACCEPT"}}, "required": ["machine_decision"]},
      "then": {
        "properties": {
          "answer": {"type": "string", "minLength": 1},
          "answer_unit": {"type": "string", "minLength": 1},
          "gate_reason_codes": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "answer": {"type": "null"},
          "answer_unit": {"type": "null"},
          "gate_reason_codes": {"minItems": 1}
        }
      }
    }
  ]
}
