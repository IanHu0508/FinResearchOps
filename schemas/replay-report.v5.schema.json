{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finauditgate:schema:replay-report:v5",
  "title": "FinAuditGate ReplayReport v5",
  "description": "Offline replay result returned by FinAuditGate.replay(). A consistent replay verifies 9 artifacts for a scripted run and 10 for a traced run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_ref",
    "consistent",
    "decision",
    "answer",
    "answer_unit",
    "verified_artifact_count",
    "reason"
  ],
  "properties": {
    "schema_version": {"const": "finauditgate.replay/v5"},
    "run_ref": {"$ref": "urn:finauditgate:schema:run-ref:v1"},
    "consistent": {"type": "boolean"},
    "decision": {
      "oneOf": [
        {"enum": ["ACCEPT", "RETRY", "ABSTAIN", "HUMAN_REVIEW"]},
        {"type": "null"}
      ]
    },
    "answer": {"type": ["string", "null"]},
    "answer_unit": {"type": ["string", "null"]},
    "verified_artifact_count": {"type": "integer", "minimum": 0},
    "reason": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"consistent": {"const": false}}, "required": ["consistent"]},
      "then": {
        "properties": {
          "decision": {"type": "null"},
          "answer": {"type": "null"},
          "answer_unit": {"type": "null"},
          "verified_artifact_count": {"const": 0},
          "reason": {"type": "string", "minLength": 1}
        }
      },
      "else": {
        "properties": {
          "decision": {"enum": ["ACCEPT", "RETRY", "ABSTAIN", "HUMAN_REVIEW"]},
          "verified_artifact_count": {"enum": [9, 10]},
          "reason": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"consistent": {"const": true}, "decision": {"const": "ACCEPT"}},
        "required": ["consistent", "decision"]
      },
      "then": {
        "properties": {
          "answer": {"type": "string", "minLength": 1},
          "answer_unit": {"type": "string", "minLength": 1}
        }
      },
      "else": {
        "properties": {"answer": {"type": "null"}, "answer_unit": {"type": "null"}}
      }
    }
  ]
}
