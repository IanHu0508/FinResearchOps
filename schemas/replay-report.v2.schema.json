{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finauditgate:schema:replay-report:v2",
  "title": "FinAuditGate ReplayReport v2",
  "description": "Offline integrity and deterministic replay result for M2 runs whose verified artifact set includes canonical attempts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_ref",
    "consistent",
    "decision",
    "answer",
    "answer_unit",
    "verified_artifact_count",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "finauditgate.replay/v2"
    },
    "run_ref": {
      "$ref": "urn:finauditgate:schema:run-ref:v1"
    },
    "consistent": {
      "type": "boolean"
    },
    "decision": {
      "oneOf": [
        {
          "enum": [
            "ACCEPT",
            "RETRY",
            "ABSTAIN",
            "HUMAN_REVIEW"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "answer_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "verified_artifact_count": {
      "type": "integer",
      "minimum": 0,
      "description": "For a consistent v2 replay this is nine: eight named run artifacts, including attempts, plus the frozen document blob."
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "consistent": {
            "const": false
          }
        },
        "required": [
          "consistent"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "type": "null"
          },
          "answer": {
            "type": "null"
          },
          "answer_unit": {
            "type": "null"
          },
          "verified_artifact_count": {
            "const": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "decision": {
            "enum": [
              "ACCEPT",
              "RETRY",
              "ABSTAIN",
              "HUMAN_REVIEW"
            ]
          },
          "verified_artifact_count": {
            "const": 9
          },
          "reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "consistent": {
            "const": true
          },
          "decision": {
            "const": "ACCEPT"
          }
        },
        "required": [
          "consistent",
          "decision"
        ]
      },
      "then": {
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "answer_unit": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "answer": {
            "type": "null"
          },
          "answer_unit": {
            "type": "null"
          }
        }
      }
    }
  ]
}
