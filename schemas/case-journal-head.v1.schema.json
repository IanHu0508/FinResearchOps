{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finresearchops:schema:case-journal-head:v1",
  "title": "FinResearchOps Case Journal Integrity Head v1",
  "description": "An atomic integrity cursor that defines the committed visible prefix and detects truncation or replacement of the immutable Case event chain. Business-state contents remain derived from the committed events, not stored in this cursor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_ref",
    "event_count",
    "tail_event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "finresearchops.case-journal-head/v1"},
    "case_ref": {"type": "string", "pattern": "^case-[0-9a-f]{64}$"},
    "event_count": {"type": "integer", "minimum": 0},
    "tail_event_sha256": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"event_count": {"const": 0}},
        "required": ["event_count"]
      },
      "then": {
        "properties": {"tail_event_sha256": {"type": "null"}}
      },
      "else": {
        "properties": {
          "tail_event_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
