{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finresearchops:schema:review-record:draft:v1",
  "title": "FinResearchOps Review Record draft v1",
  "description": "M1 data-contract draft for a human action against one immutable FinAuditGate run. Append-only persistence and legal transitions belong to M2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_ref",
    "case_ref",
    "run_ref",
    "workpaper_ref",
    "action",
    "reason",
    "recorded_at",
    "previous_case_status",
    "resulting_case_status"
  ],
  "properties": {
    "schema_version": {
      "const": "finresearchops.review-record/draft-v1"
    },
    "review_ref": {
      "type": "string",
      "minLength": 1
    },
    "case_ref": {
      "type": "string",
      "minLength": 1
    },
    "run_ref": {
      "$ref": "urn:finauditgate:schema:run-ref:v1"
    },
    "workpaper_ref": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "enum": [
        "APPROVE",
        "RETURN",
        "REJECT"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "previous_case_status": {
      "enum": [
        "AWAITING_REVIEW"
      ]
    },
    "resulting_case_status": {
      "enum": [
        "APPROVED",
        "RETURNED",
        "REJECTED"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "APPROVE"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "resulting_case_status": {
            "const": "APPROVED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "RETURN"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "resulting_case_status": {
            "const": "RETURNED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "REJECT"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "resulting_case_status": {
            "const": "REJECTED"
          }
        }
      }
    }
  ]
}
