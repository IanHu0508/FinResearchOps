{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finresearchops:schema:research-change-packet:draft:v1",
  "title": "FinResearchOps Research Change Packet draft v1",
  "description": "M1 data-contract draft for a non-binding research-change proposal. Eligibility and export behavior belong to M2; this contract cannot modify formal research state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_ref",
    "case_ref",
    "run_ref",
    "review_ref",
    "workpaper_ref",
    "proposal_only",
    "verified_facts",
    "calculations",
    "impact_statement",
    "unresolved_items"
  ],
  "properties": {
    "schema_version": {
      "const": "finresearchops.research-change-packet/draft-v1"
    },
    "packet_ref": {
      "type": "string",
      "minLength": 1
    },
    "case_ref": {
      "type": "string",
      "minLength": 1
    },
    "run_ref": {
      "$ref": "urn:finauditgate:schema:run-ref:v1"
    },
    "review_ref": {
      "type": "string",
      "minLength": 1
    },
    "workpaper_ref": {
      "type": "string",
      "minLength": 1
    },
    "proposal_only": {
      "const": true
    },
    "verified_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "metric",
          "period",
          "value",
          "unit"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "operand_ids",
          "result",
          "output_unit"
        ],
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "operand_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "result": {
            "type": "string",
            "minLength": 1
          },
          "output_unit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "impact_statement": {
      "type": "string",
      "minLength": 1
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
