{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThesisCase",
  "type": "object",
  "required": [
    "request",
    "topology",
    "reports",
    "initial",
    "revisions",
    "research_evaluation",
    "execution_review",
    "risk_briefs",
    "final_assessment",
    "updated_claims",
    "exchanges",
    "model_calls",
    "tool_calls",
    "schema_version",
    "status",
    "review_status",
    "upstream_commit",
    "runtime_kind",
    "model",
    "source_bundle",
    "signal",
    "budget",
    "financial_gate",
    "automatic_trading"
  ],
  "properties": {
    "request": {
      "type": "object"
    },
    "topology": {
      "type": "object"
    },
    "reports": {
      "type": "object"
    },
    "initial": {
      "type": "object"
    },
    "revisions": {
      "type": "object"
    },
    "research_evaluation": {
      "$ref": "#/$defs/ResearchEvaluation"
    },
    "execution_review": {
      "$ref": "#/$defs/ExecutionReview"
    },
    "risk_briefs": {
      "type": "object"
    },
    "final_assessment": {
      "$ref": "#/$defs/FinalAssessment"
    },
    "updated_claims": {
      "type": "array"
    },
    "exchanges": {
      "type": "array"
    },
    "model_calls": {
      "type": "array"
    },
    "tool_calls": {
      "type": "array"
    },
    "schema_version": {
      "const": "finresearchops.thesis-case/v2"
    },
    "status": {
      "const": "COMPLETED"
    },
    "review_status": {
      "const": "AWAITING_REVIEW"
    },
    "upstream_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "runtime_kind": {
      "enum": [
        "REAL_MODEL",
        "OFFLINE_SYNTHETIC"
      ]
    },
    "model": {
      "type": "string"
    },
    "source_bundle": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FrozenThesisSources",
      "type": "object",
      "required": [
        "schema_version",
        "symbol",
        "as_of",
        "identity",
        "sources"
      ],
      "properties": {
        "schema_version": {
          "const": "finresearchops.thesis-sources/v1"
        },
        "symbol": {
          "type": "string"
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "identity": {
          "type": "object"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 48,
          "items": {
            "type": "object",
            "required": [
              "id",
              "origin",
              "availability_note",
              "content",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "availability_note": {
                "type": "string",
                "minLength": 1
              },
              "content": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "signal": {
      "enum": [
        "Buy",
        "Overweight",
        "Hold",
        "Underweight",
        "Sell",
        "REVIEW"
      ]
    },
    "budget": {
      "type": [
        "object",
        "null"
      ]
    },
    "financial_gate": {
      "const": "NOT_REQUIRED"
    },
    "automatic_trading": {
      "const": false
    },
    "reused_calls": {
      "type": "object",
      "required": [
        "runtime_sha256",
        "available_calls",
        "used_calls",
        "prior_budget"
      ],
      "properties": {
        "runtime_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "available_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "used_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "prior_budget": {
          "type": [
            "object",
            "null"
          ]
        },
        "prior_reuse": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "business_mechanism": {
          "minLength": 1,
          "title": "Business Mechanism",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Refs",
          "type": "array"
        },
        "would_change_mind": {
          "minLength": 1,
          "title": "Would Change Mind",
          "type": "string"
        },
        "uncertainty": {
          "minLength": 1,
          "title": "Uncertainty",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "business_mechanism",
        "evidence_refs",
        "would_change_mind",
        "uncertainty"
      ],
      "title": "Claim",
      "type": "object"
    },
    "InitialBrief": {
      "additionalProperties": false,
      "description": "Complete JSON response object with every required field and no surrounding prose.",
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Claims",
          "type": "array"
        }
      },
      "required": [
        "claims"
      ],
      "title": "InitialBrief",
      "type": "object"
    },
    "ClaimUpdate": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "maintain",
            "revise",
            "withdraw",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "updated_statement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only revise supplies a replacement; otherwise null.",
          "title": "Updated Statement"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Refs",
          "type": "array"
        },
        "would_change_mind": {
          "minLength": 1,
          "title": "Would Change Mind",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "status",
        "updated_statement",
        "reason",
        "evidence_refs",
        "would_change_mind"
      ],
      "title": "ClaimUpdate",
      "type": "object"
    },
    "CounterResponse": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "response": {
          "enum": [
            "acknowledge",
            "dispute",
            "unresolved"
          ],
          "title": "Response",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "response",
        "reason",
        "evidence_refs"
      ],
      "title": "CounterResponse",
      "type": "object"
    },
    "RevisionBrief": {
      "additionalProperties": false,
      "description": "Complete JSON response containing updates AND counter_responses together.",
      "properties": {
        "updates": {
          "items": {
            "$ref": "#/$defs/ClaimUpdate"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Updates",
          "type": "array"
        },
        "counter_responses": {
          "items": {
            "$ref": "#/$defs/CounterResponse"
          },
          "maxItems": 4,
          "minItems": 2,
          "title": "Counter Responses",
          "type": "array"
        }
      },
      "required": [
        "updates",
        "counter_responses"
      ],
      "title": "RevisionBrief",
      "type": "object"
    },
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "use",
            "conditional",
            "reject"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "disposition",
        "reason"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "ResearchPlan": {
      "additionalProperties": false,
      "properties": {
        "recommendation": {
          "description": "Research stance from this analysis. REVIEW means insufficient basis to rate; Hold means a supported neutral view.",
          "enum": [
            "Buy",
            "Overweight",
            "Hold",
            "Underweight",
            "Sell",
            "REVIEW"
          ],
          "title": "Recommendation",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "strategic_actions": {
          "description": "Conditional next steps; do not invent holdings or personal risk constraints.",
          "title": "Strategic Actions",
          "type": "string"
        }
      },
      "required": [
        "recommendation",
        "rationale",
        "strategic_actions"
      ],
      "title": "ResearchPlan",
      "type": "object"
    },
    "ResearchEvaluation": {
      "additionalProperties": false,
      "description": "Complete JSON response containing plan, assessments and valuation_basis_and_gaps.",
      "properties": {
        "plan": {
          "$ref": "#/$defs/ResearchPlan"
        },
        "assessments": {
          "items": {
            "$ref": "#/$defs/Assessment"
          },
          "maxItems": 8,
          "minItems": 4,
          "title": "Assessments",
          "type": "array"
        },
        "valuation_basis_and_gaps": {
          "minLength": 1,
          "title": "Valuation Basis And Gaps",
          "type": "string"
        }
      },
      "required": [
        "plan",
        "assessments",
        "valuation_basis_and_gaps"
      ],
      "title": "ResearchEvaluation",
      "type": "object"
    },
    "TraderProposal": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "Buy",
            "Hold",
            "Sell"
          ],
          "title": "Action",
          "type": "string"
        },
        "reasoning": {
          "minLength": 1,
          "title": "Reasoning",
          "type": "string"
        },
        "entry_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Price"
        },
        "stop_loss": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Loss"
        },
        "position_sizing": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position Sizing"
        }
      },
      "required": [
        "action",
        "reasoning"
      ],
      "title": "TraderProposal",
      "type": "object"
    },
    "ExecutionReview": {
      "additionalProperties": false,
      "description": "Complete JSON execution review, not a free-text transaction report.",
      "properties": {
        "proposal": {
          "$ref": "#/$defs/TraderProposal"
        },
        "feasibility_conditions": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Feasibility Conditions",
          "type": "array"
        },
        "missing_portfolio_inputs": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Missing Portfolio Inputs",
          "type": "array"
        }
      },
      "required": [
        "proposal",
        "feasibility_conditions",
        "missing_portfolio_inputs"
      ],
      "title": "ExecutionReview",
      "type": "object"
    },
    "RiskBrief": {
      "additionalProperties": false,
      "description": "Complete JSON risk review containing every required field.",
      "properties": {
        "analysis": {
          "minLength": 1,
          "title": "Analysis",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Refs",
          "type": "array"
        },
        "invalidation_conditions": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Invalidation Conditions",
          "type": "array"
        }
      },
      "required": [
        "analysis",
        "evidence_refs",
        "invalidation_conditions"
      ],
      "title": "RiskBrief",
      "type": "object"
    },
    "PortfolioDecision": {
      "additionalProperties": false,
      "properties": {
        "rating": {
          "description": "Fresh evidence-based research stance. REVIEW if there is no defensible rating; never use Hold as a missing-data placeholder.",
          "enum": [
            "Buy",
            "Overweight",
            "Hold",
            "Underweight",
            "Sell",
            "REVIEW"
          ],
          "title": "Rating",
          "type": "string"
        },
        "executive_summary": {
          "description": "Conclusion, confidence and material conditions. Do not invent personal position advice.",
          "minLength": 1,
          "title": "Executive Summary",
          "type": "string"
        },
        "investment_thesis": {
          "minLength": 1,
          "title": "Investment Thesis",
          "type": "string"
        },
        "price_target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Target"
        },
        "time_horizon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time Horizon"
        }
      },
      "required": [
        "rating",
        "executive_summary",
        "investment_thesis"
      ],
      "title": "PortfolioDecision",
      "type": "object"
    },
    "FinalAssessment": {
      "additionalProperties": false,
      "description": "Complete JSON response: decision, all assessments and every other required field.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/PortfolioDecision"
        },
        "assessments": {
          "items": {
            "$ref": "#/$defs/Assessment"
          },
          "maxItems": 8,
          "minItems": 4,
          "title": "Assessments",
          "type": "array"
        },
        "strongest_counterevidence": {
          "minLength": 1,
          "title": "Strongest Counterevidence",
          "type": "string"
        },
        "why_it_changes_or_does_not_change_the_view": {
          "minLength": 1,
          "title": "Why It Changes Or Does Not Change The View",
          "type": "string"
        },
        "valuation_basis_and_gaps": {
          "minLength": 1,
          "title": "Valuation Basis And Gaps",
          "type": "string"
        },
        "next_observations": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Next Observations",
          "type": "array"
        },
        "financial_analysis": {
          "$ref": "#/$defs/FinancialAnalysis"
        }
      },
      "required": [
        "decision",
        "assessments",
        "strongest_counterevidence",
        "why_it_changes_or_does_not_change_the_view",
        "valuation_basis_and_gaps",
        "next_observations",
        "financial_analysis"
      ],
      "title": "FinalAssessment",
      "type": "object"
    },
    "ReviewFinding": {
      "additionalProperties": false,
      "properties": {
        "issue": {
          "minLength": 1,
          "title": "Issue",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Evidence Refs",
          "type": "array"
        },
        "next_check": {
          "minLength": 1,
          "title": "Next Check",
          "type": "string"
        }
      },
      "required": [
        "issue",
        "evidence_refs",
        "next_check"
      ],
      "title": "ReviewFinding",
      "type": "object"
    },
    "DataReview": {
      "additionalProperties": false,
      "description": "Complete JSON data review containing findings and coverage_and_limits.",
      "properties": {
        "findings": {
          "items": {
            "$ref": "#/$defs/ReviewFinding"
          },
          "maxItems": 8,
          "title": "Findings",
          "type": "array"
        },
        "coverage_and_limits": {
          "minLength": 1,
          "title": "Coverage And Limits",
          "type": "string"
        }
      },
      "required": [
        "findings",
        "coverage_and_limits"
      ],
      "title": "DataReview",
      "type": "object"
    },
    "FinancialAnalysis": {
      "additionalProperties": false,
      "properties": {
        "operating_performance": {
          "description": "Revenue, business drivers and margin changes, separating observed results from sustainability hypotheses; show a comparable-period bridge where supported.",
          "minLength": 1,
          "title": "Operating Performance",
          "type": "string"
        },
        "earnings_quality": {
          "description": "Operating profit to pretax, tax and attributable income; GAAP/non-GAAP definition and cash-flow adjustments. Identify source conflicts and unresolved attribution.",
          "minLength": 1,
          "title": "Earnings Quality",
          "type": "string"
        },
        "cash_and_capital_allocation": {
          "description": "Cash balance vs cash generation, capex/working capital, restricted or subsidiary cash, dividends/buybacks and dilution; never equate consolidated cash with distributable parent cash.",
          "minLength": 1,
          "title": "Cash And Capital Allocation",
          "type": "string"
        },
        "valuation_and_price_requirements": {
          "description": "Explicit earnings period, currency/share basis, reproducible valuation arithmetic and assumptions. Link operating changes to valuation. Distinguish conditional price requirements, forecasts and fair value; omit unsupported targets.",
          "minLength": 1,
          "title": "Valuation And Price Requirements",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "operating_performance",
        "earnings_quality",
        "cash_and_capital_allocation",
        "valuation_and_price_requirements",
        "evidence_refs"
      ],
      "title": "FinancialAnalysis",
      "type": "object"
    }
  }
}
