{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finresearchops:schema:replay-record:v3",
  "title": "FinResearchOps Replay Record v3",
  "description": "A successful offline replay of one Case run, persisted once. Inconsistent replays are never recorded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_ref",
    "run_ref",
    "report",
    "replay_ref"
  ],
  "properties": {
    "schema_version": {"const": "finresearchops.replay-record/v3"},
    "case_ref": {"type": "string", "pattern": "^case-[0-9a-f]{64}$"},
    "run_ref": {"$ref": "urn:finauditgate:schema:run-ref:v1"},
    "report": {"$ref": "urn:finauditgate:schema:replay-report:v5"},
    "replay_ref": {"type": "string", "pattern": "^replay-[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "properties": {
        "report": {
          "type": "object",
          "properties": {"consistent": {"const": true}},
          "required": ["consistent"]
        }
      }
    }
  ]
}
