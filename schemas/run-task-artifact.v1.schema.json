{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finauditgate:schema:run-task-artifact:v1",
  "title": "Persisted FinAuditGate Run Task Artifact v1",
  "description": "Canonical JSON artifact derived from the Python AuditTask Interface. AuditTask carries a FrozenDocumentPackage with immutable bytes and caller-declared metadata; this persisted form binds the bytes by document_sha256 instead of duplicating them. Declared metadata is not proof that a source is official or verified.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "question",
    "cutoff",
    "source_id",
    "document_name",
    "document_sha256",
    "declared_published_at",
    "answer_contract",
    "risk_class",
    "mode"
  ],
  "properties": {
    "schema_version": {
      "const": "finauditgate.task/v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "cutoff": {
      "type": "string",
      "format": "date"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "document_name": {
      "type": "string",
      "minLength": 1
    },
    "document_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "declared_published_at": {
      "type": "string",
      "format": "date"
    },
    "answer_contract": {
      "const": "PERCENTAGE_CHANGE"
    },
    "risk_class": {
      "enum": [
        "LOW",
        "MEDIUM",
        "MATERIAL"
      ]
    },
    "mode": {
      "enum": [
        "SYNTHETIC_DEV",
        "PRIVATE_DEV",
        "POST_FREEZE_EVAL"
      ]
    }
  }
}
